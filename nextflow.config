params {
    mode              = 'timepoint_build'
    method_registry = "${projectDir}/configs/container_methods.json"
    methods = null
    method_run_purpose = 'evaluation'
    protea_allow_missing_batches = false
    method_output_root = "${projectDir}/data/method_runs"
    method_gpu_options = '--gres=gpu:a100:1'
    goboost_data_dir = "${projectDir}/goboost_data"
    protea_bundle_dir = "${projectDir}/protea_data/bundle"
    protea_backbone_dir = "${projectDir}/protea_data"
    protea_graph = "${projectDir}/new_data/time_points/Sep_2025/release/go-basic.obo"
    model_organism_config = "${projectDir}/configs/model_organism_annotations.yaml"
    model_organism_mapping_config = null
    model_organism_release = null
    model_organism_output_root = "${projectDir}/data/resource_intake"
    resource_release = null
    go_release = null
    timepoint_input_mode = 'download'
    model_organism_bundle = null
    model_organism_bundle_source = 'current'
    expected_runtime_source_identity = null
    source_policy_migration = null
    trusted_published_t0 = false
    published_release_catalog = null
    frozen_graph = "${projectDir}/new_data/time_points/Sep_2025/release/go-basic.obo"
    output_root       = "${projectDir}"
    publish_root      = "${projectDir}/data/releases"
    timepoint_id      = null
    timepoint_root    = null
    t0_id             = null
    t1_id             = null
    t0_root           = null
    t1_root           = null
    release_id        = null
    release_root      = null
    method_names_file = null
    query_fasta       = null
    queryFasta        = null
    split_size        = 32
    prediction_target_mode = 'window_groundtruth'
    window_prediction_subdir = 'predictions_by_window'
    window_prediction_mode = null
    windowPredictionMode = null
    window_predictions_dir = null
    windowPredictionsDir = null
    funbind_batch_size = 20
    funbind_allow_missing_batches = true
    enabled_window_methods = [
        'naive',
        'goa_nonexp',
        'blast',
        'prott5',
        'transfew',
        'funbind',
        'deepgoplus'
    ]
    workspace_root    = "${projectDir}"
    democafa_package  = "/work/idoerg/ahphan/democafa_package"
    democafa_env      = "democafaenv"
    cafaeval_env      = "cafa5-evaluator"
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']

    withName: 'EVALUATE_WINDOW:PREDICT_NAIVE' {
        errorStrategy = 'ignore'
    }

    withName: 'EVALUATE_WINDOW:PREDICT_GOA_NONEXP' {
        errorStrategy = 'ignore'
    }

    withName: 'EVALUATE_WINDOW:PREDICT_BLAST' {
        errorStrategy = 'ignore'
    }

    withName: 'EVALUATE_WINDOW:PREDICT_PROTT5' {
        errorStrategy = 'ignore'
    }

    withName: 'EVALUATE_WINDOW:PREDICT_TRANSFEW' {
        errorStrategy = 'ignore'
    }

    withName: 'EVALUATE_WINDOW:PREDICT_FUNBIND_BATCH' {
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
    }

    withName: 'EVALUATE_WINDOW:PREDICT_DEEPGOPLUS' {
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withLabel: 'cpu_small' {
        cpus = 4
        memory = '16 GB'
        time = '6h'
    }

    withLabel: 'cpu_medium' {
        cpus = 16
        memory = '64 GB'
        time = '12h'
    }

    withLabel: 'cpu_large' {
        cpus = 16
        memory = '128 GB'
        time = '24h'
    }

    withLabel: 'gpu_a100' {
        cpus = 16
        memory = '128 GB'
        time = '36h'
    }

    withLabel: 'packaging' {
        cpus = 2
        memory = '8 GB'
        time = '2h'
    }
}

profiles {
    local {
        process {
            executor = 'local'
        }
    }

    slurm {
        apptainer.enabled = true

        process {
            executor = 'slurm'
            queue = null

            withLabel: 'cpu_small' {
                cpus = 4
                memory = '16 GB'
                time = '2h'
            }

            withLabel: 'cpu_medium' {
                cpus = 16
                memory = '64 GB'
                time = '12h'
            }

            withLabel: 'cpu_large' {
                cpus = 16
                memory = '128 GB'
                time = '24h'
            }

            withLabel: 'gpu_a100' {
                cpus = 16
                memory = '128 GB'
                time = '36h'
                clusterOptions = '--gres=gpu:a100:1'
            }

            withLabel: 'gpu_scavenger' {
                cpus = 16
                memory = '256 GB'
                time = '2h'
                clusterOptions = '--partition=scavenger --gres=gpu:a100:1'
            }

            withLabel: 'packaging' {
                cpus = 2
                memory = '8 GB'
                time = '2h'
            }
        }
    }
}
